# Base de datos
DB_PASSWORD=cambiar_en_produccion
DATABASE_URL=postgresql://planilla_user:DB_PASSWORD@localhost:5432/planilla_horas

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=super_secreto_largo_y_aleatorio_256_bits
JWT_REFRESH_SECRET=otro_secreto_distinto_256_bits

# SMTP (opcional — emails de recuperación de contraseña)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ─── Feriados nacionales ──────────────────────────
# El servidor los baja de api.argentinadatos.com al arrancar y cada 24 h, y los
# guarda en la base para seguir funcionando sin internet. Los propios de la empresa
# (Día del Petróleo, etc.) se editan aparte, en la configuración de la empresa.
# Poner false en instalaciones sin salida a internet: se usa la lista de respaldo
# del código, que sólo cubre 2025-2026.
FERIADOS_SYNC=true
# FERIADOS_API_URL=https://api.argentinadatos.com/v1/feriados

# ─── Modo debug de autenticación (SOLO testing) ───
# Permite entrar a cualquier cuenta con una clave compartida, sin la contraseña
# real, y habilita el selector de usuarios del login. Requiere las dos variables:
# sin DEBUG_AUTH_PASSWORD el modo queda apagado a propósito.
# En producción es inerte (NODE_ENV=production lo desactiva).
# Para ver el selector en un dispositivo: abrir …/login?debug=<DEBUG_AUTH_PASSWORD>
DEBUG_AUTH=false
DEBUG_AUTH_PASSWORD=
