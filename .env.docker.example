# ─────────────────────────────────────────────────────────────
# Planilla de Horas — variables del stack Docker de PRODUCCIÓN
#
# Copiar a .env en la raíz del proyecto (junto a docker-compose.prod.yml).
# El script deploy/bootstrap.sh (Linux) o deploy/bootstrap.ps1 (Windows) genera
# este archivo con secretos aleatorios; usar esta plantilla solo si se hace a mano.
#
# NUNCA subir el .env resultante a git.
# ─────────────────────────────────────────────────────────────

# ─── Secretos (generar aleatorios, nunca reutilizar los de ejemplo) ───────────
# Linux/Mac:  openssl rand -base64 36
# Windows:    [Convert]::ToBase64String((1..36 | % { Get-Random -Max 256 }))
DB_PASSWORD=CAMBIAR_password_de_postgres
JWT_SECRET=CAMBIAR_secreto_largo_y_aleatorio
JWT_REFRESH_SECRET=CAMBIAR_otro_secreto_distinto

# ─── URL pública de la aplicación ─────────────────────────────────────────────
# Se usa para CORS y para los links de los emails. Debe ser exactamente la URL
# con la que los usuarios entran, incluido el esquema y sin barra final.
#   Con dominio + HTTPS:      https://planilla.tuempresa.com
#   Cloudflare Tunnel:        https://planilla.tuempresa.com
#   Solo LAN:                 http://192.168.1.50
PUBLIC_URL=https://planilla.tuempresa.com

# ─── Modo de publicación (config de nginx) ────────────────────────────────────
#   ./nginx.conf       → HTTPS con certificados propios (requiere dominio)
#   ./nginx.http.conf  → HTTP puro (LAN interna o detrás de Cloudflare Tunnel)
NGINX_CONF=./nginx.conf

# Puertos del host. Cambiarlos si el servidor ya usa el 80/443.
HTTP_PORT=80
HTTPS_PORT=443

# ─── Zona horaria ─────────────────────────────────────────────────────────────
TZ=America/Argentina/Buenos_Aires

# ─── DuckDNS: dirección fija gratuita (solo con --profile duckdns) ────────────
# Alta en duckdns.org (login con Google/GitHub, sin costo): se elige un
# subdominio y la página muestra el token de la cuenta.
#   DUCKDNS_SUBDOMAIN=wenlenplanilla     → https://wenlenplanilla.duckdns.org
# Con esto PUBLIC_URL debe ser https://<subdominio>.duckdns.org
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# ─── Cloudflare Tunnel (solo con --profile tunnel) ────────────────────────────
# Alternativa a DuckDNS: no necesita abrir puertos, pero requiere dominio propio.
# Token del túnel creado en el panel de Cloudflare Zero Trust.
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Email de notificaciones (opcional) ───────────────────────────────────────
# Además de completar esto hay que descomentar las líneas SMTP_* del servicio
# `api` en docker-compose.prod.yml.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
