// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles are now dynamic strings managed via the RolConfig table
// Default roles: OPERADOR, SUPERVISOR, COORDINADOR, GERENTE, RRHH, ADMIN

enum PlanillaEstado {
  BORRADOR
  ENVIADA
  EN_REVISION
  APROBADA
  RECHAZADA
  CERRADA
}

enum VacacionEstado {
  BORRADOR
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
}

enum AusenciaTipo {
  CERTIFICADO_MEDICO
  FALTA_JUSTIFICADA
  FALTA_INJUSTIFICADA
  LICENCIA_ESPECIAL
  FRANCO_COMPENSATORIO
}

enum AusenciaEstado {
  BORRADOR
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
}

enum LugarTrabajo {
  BASE
  CAMPO
  FRANCO
}

enum PernocteEnum {
  NO
  HOTEL
  TRAILER
}

enum DiagramaTipo {
  ROTATIVO
  FIJO_SEMANA
}

enum CambioDiagramaEstado {
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
}

enum ContratoTipo {
  PRUEBA
  INDEFINIDO
  PLAZO_FIJO
  EVENTUAL
}

// ═══════════════════════════════════════════════════════
// EMPRESA
// ═══════════════════════════════════════════════════════

model Empresa {
  id        String   @id @default(uuid())
  nombre    String
  cuit      String?
  direccion String?
  logoUrl   String?  @map("logo_url")
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sectores              Sector[]
  usuarios              Usuario[]
  diagramas             Diagrama[]
  flujos                FlujoAprobacion[]
  config                EmpresaConfig?
  vacacionesConfig      VacacionesConfig?
  exportaciones         Exportacion[]
  exportacionPlantillas ExportacionPlantilla[]
  proyectos             Proyecto[]
  tiposCapacitacion     TipoCapacitacion[]
  sesionesCapacitacion  SesionCapacitacion[]
  alertasConfig         AlertaConfig[]
  roles                 RolConfig[]
  mensajes              Mensaje[]
  wentopTarjetas        WentopTarjeta[]
  wentopGestores        WentopGestor[]

  @@map("empresas")
}

// ═══════════════════════════════════════════════════════
// ROL CONFIG (dynamic roles)
// ═══════════════════════════════════════════════════════

model RolConfig {
  id          String   @id @default(uuid())
  empresaId   String   @map("empresa_id")
  codigo      String   // e.g. OPERADOR, SUPERVISOR, CUSTOM_ROLE
  nombre      String   // Display name
  descripcion String?
  color       String?  // Badge color hex
  nivel       Int      @default(0) // Permission level (higher = more access)
  esSistema   Boolean  @default(false) @map("es_sistema") // Cannot be deleted
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, codigo])
  @@map("roles_config")
}

// ═══════════════════════════════════════════════════════
// PASSWORD RESET TOKENS
// ═══════════════════════════════════════════════════════

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  usuarioId String   @map("usuario_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  usuarioId String   @map("usuario_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════════════
// SECTOR
// ═══════════════════════════════════════════════════════

model Sector {
  id          String   @id @default(uuid())
  empresaId   String   @map("empresa_id")
  nombre      String
  descripcion String?
  color       String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  empresa            Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarios           Usuario[]
  flujoAsignaciones  FlujoAsignacion[]
  wentopTarjetas     WentopTarjeta[]   @relation("wentop_sector_observacion")
  wentopGestores     WentopGestor[]

  @@map("sectores")
}

// ═══════════════════════════════════════════════════════
// DIAGRAMAS DE TRABAJO
// ═══════════════════════════════════════════════════════

model Diagrama {
  id           String       @id @default(uuid())
  empresaId    String       @map("empresa_id")
  nombre       String
  tipo         DiagramaTipo
  diasTrabajo  Int?         @map("dias_trabajo")
  diasDescanso Int?         @map("dias_descanso")
  diasSemana   Int[]        @map("dias_semana")
  descripcion  String?
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")

  empresa      Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  asignaciones UsuarioDiagrama[]
  cambiosDesdeDiagrama SolicitudCambioDiagrama[] @relation("cambio_diagrama_actual")
  cambiosHaciaDiagrama SolicitudCambioDiagrama[] @relation("cambio_diagrama_nuevo")

  @@map("diagramas")
}

model UsuarioDiagrama {
  id          String    @id @default(uuid())
  usuarioId   String    @map("usuario_id")
  diagramaId  String    @map("diagrama_id")
  fechaInicio DateTime  @map("fecha_inicio")
  fechaFin    DateTime? @map("fecha_fin")
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  diagrama Diagrama @relation(fields: [diagramaId], references: [id])

  @@map("usuarios_diagramas")
}

// ═══════════════════════════════════════════════════════
// FLUJOS DE APROBACIÓN
// ═══════════════════════════════════════════════════════

model FlujoAprobacion {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  nombre        String
  tipoDocumento String   @map("tipo_documento")
  descripcion   String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  empresa      Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pasos        FlujoPaso[]
  asignaciones FlujoAsignacion[]
  planillas    Planilla[]
  vacaciones   Vacacion[]
  ausencias    Ausencia[]
  cambiosDiagrama SolicitudCambioDiagrama[]

  @@map("flujos_aprobacion")
}

model FlujoPaso {
  id                        String   @id @default(uuid())
  flujoId                   String   @map("flujo_id")
  orden                     Int
  nombrePaso                String   @map("nombre_paso")
  rolAprobador              String   @map("rol_aprobador")
  usuarioEspecificoId       String?  @map("usuario_especifico_id")
  accionAprobar             String   @default("APROBAR") @map("accion_aprobar")
  accionRechazar            String   @default("RECHAZAR") @map("accion_rechazar")
  requiereComentarioRechazo Boolean  @default(true) @map("requiere_comentario_rechazo")
  notificarRoles            String[] @map("notificar_roles")
  tiempoLimiteHoras         Int?     @map("tiempo_limite_horas")
  createdAt                 DateTime @default(now()) @map("created_at")

  flujo             FlujoAprobacion @relation(fields: [flujoId], references: [id], onDelete: Cascade)
  usuarioEspecifico Usuario?        @relation("pasos_usuario_especifico", fields: [usuarioEspecificoId], references: [id])

  @@map("flujos_pasos")
}

model FlujoAsignacion {
  id            String  @id @default(uuid())
  flujoId       String  @map("flujo_id")
  tipoDocumento String  @map("tipo_documento")
  sectorId      String? @map("sector_id")
  usuarioId     String? @map("usuario_id")
  activo        Boolean @default(true)

  flujo   FlujoAprobacion @relation(fields: [flujoId], references: [id])
  sector  Sector?         @relation(fields: [sectorId], references: [id])
  usuario Usuario?        @relation("flujo_asignaciones_usuario", fields: [usuarioId], references: [id])

  @@map("flujos_asignaciones")
}

// ═══════════════════════════════════════════════════════
// USUARIO
// ═══════════════════════════════════════════════════════

model Usuario {
  id                   String       @id @default(uuid())
  empresaId            String       @map("empresa_id")
  sectorId             String?      @map("sector_id")
  nombre               String
  apellido             String
  email                String       @unique
  passwordHash         String       @map("password_hash")
  legajo               String?
  dni                  String?
  cuil                 String?
  fechaNacimiento      DateTime?    @map("fecha_nacimiento")
  telefono             String?
  avatarUrl            String?      @map("avatar_url")
  rol                  String       @default("OPERADOR")
  tipoContrato         ContratoTipo @default(INDEFINIDO) @map("tipo_contrato")
  fechaIngreso         DateTime     @map("fecha_ingreso")
  fechaFinPrueba       DateTime?    @map("fecha_fin_prueba")
  fechaEgreso          DateTime?    @map("fecha_egreso")
  coordinadorId        String?      @map("coordinador_id")
  supervisorId         String?      @map("supervisor_id")
  diasVacacionesSaldo  Int          @default(0) @map("dias_vacaciones_saldo")
  diasVacacionesUsados Int          @default(0) @map("dias_vacaciones_usados")
  activo               Boolean      @default(true)
  primerLogin          Boolean      @default(true) @map("primer_login")
  diagramaColor        String?      @map("diagrama_color") // AZUL | AMARILLO | BASE — visual badge for Well Testing
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  empresa            Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sector             Sector?             @relation(fields: [sectorId], references: [id])
  coordinador        Usuario?            @relation("coordinador_subordinados", fields: [coordinadorId], references: [id])
  supervisor         Usuario?            @relation("supervisor_subordinados", fields: [supervisorId], references: [id])
  subordinadosCoord  Usuario[]           @relation("coordinador_subordinados")
  subordinadosSup    Usuario[]           @relation("supervisor_subordinados")
  diagramas          UsuarioDiagrama[]
  planillas          Planilla[]
  planillasAprobadas Planilla[]          @relation("planilla_aprobador")
  planillaHistorial  PlanillaHistorial[]
  vacaciones         Vacacion[]
  vacacionesAprobadas Vacacion[]         @relation("vacacion_aprobador")
  vacacionHistorial  VacacionHistorial[]
  ausencias          Ausencia[]
  ausenciasCargadas  Ausencia[]          @relation("ausencia_cargador")
  ausenciasAprobadas Ausencia[]          @relation("ausencia_aprobador")
  ausenciaHistorial  AusenciaHistorial[]
  notificaciones     Notificacion[]
  pasosEspecificos   FlujoPaso[]         @relation("pasos_usuario_especifico")
  flujoAsignaciones  FlujoAsignacion[]   @relation("flujo_asignaciones_usuario")
  exportaciones      Exportacion[]
  exportacionPlantillas ExportacionPlantilla[]
  capacitaciones     EmpleadoCapacitacion[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens      RefreshToken[]
  vacacionSaldos     VacacionSaldo[]
  mensajesEnviados   Mensaje[]            @relation("mensajesEnviados")
  mensajesRecibidos  MensajeDestinatario[] @relation("mensajesRecibidos")
  respuestasMensaje  MensajeRespuesta[]   @relation("respuestasMensaje")
  sesionesOrganizadas     SesionCapacitacion[]     @relation("sesiones_organizadas")
  invitacionesCapacitacion InvitacionCapacitacion[] @relation("invitaciones_capacitacion")
  cambiosDiagramaSolicitados  SolicitudCambioDiagrama[]  @relation("cambio_diagrama_solicitante")
  cambiosDiagramaAfectados    SolicitudCambioDiagrama[]  @relation("cambio_diagrama_usuario")
  cambiosDiagramaAprobados    SolicitudCambioDiagrama[]  @relation("cambio_diagrama_aprobador")
  cambioDiagramaHistorial     CambioDiagramaHistorial[]
  auditoriaLogs               AuditoriaLog[]             @relation("auditoria_usuario")
  wentopTarjetas              WentopTarjeta[]
  wentopGestiones             WentopGestor[]

  @@map("usuarios")
}

// ═══════════════════════════════════════════════════════
// PLANILLAS DE HORAS
// ═══════════════════════════════════════════════════════

model Planilla {
  id                 String         @id @default(uuid())
  usuarioId          String         @map("usuario_id")
  flujoId            String?        @map("flujo_id")
  periodoInicio      DateTime       @map("periodo_inicio")
  periodoFin         DateTime       @map("periodo_fin")
  estado             PlanillaEstado @default(BORRADOR)
  pasoActual         Int            @default(0) @map("paso_actual")
  obsRechazo         String?        @map("obs_rechazo")
  aprobadaPorId      String?        @map("aprobada_por_id")
  enviadaAt          DateTime?      @map("enviada_at")
  aprobadaAt         DateTime?      @map("aprobada_at")
  cerradaAt          DateTime?      @map("cerrada_at")
  snapshotCalculo    Json?          @map("snapshot_calculo")
  totalHorasNormales Decimal        @default(0) @map("total_horas_normales") @db.Decimal(7, 2)
  totalHorasExtra50  Decimal        @default(0) @map("total_horas_extra_50") @db.Decimal(7, 2)
  totalHorasExtra100 Decimal        @default(0) @map("total_horas_extra_100") @db.Decimal(7, 2)
  totalHorasViaje    Decimal        @default(0) @map("total_horas_viaje") @db.Decimal(7, 2)
  totalDiasCampo     Int            @default(0) @map("total_dias_campo")
  totalDiasBase      Int            @default(0) @map("total_dias_base")
  netoEstimado       Decimal?       @map("neto_estimado") @db.Decimal(12, 2)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  usuario     Usuario             @relation(fields: [usuarioId], references: [id])
  aprobadaPor Usuario?            @relation("planilla_aprobador", fields: [aprobadaPorId], references: [id])
  flujo       FlujoAprobacion?    @relation(fields: [flujoId], references: [id])
  registros   RegistroHoras[]
  historial   PlanillaHistorial[]

  @@map("planillas")
}

model PlanillaHistorial {
  id             String          @id @default(uuid())
  planillaId     String          @map("planilla_id")
  usuarioId      String          @map("usuario_id")
  estadoAnterior PlanillaEstado? @map("estado_anterior")
  estadoNuevo    PlanillaEstado  @map("estado_nuevo")
  pasoFlujo      Int?            @map("paso_flujo")
  comentario     String?
  createdAt      DateTime        @default(now()) @map("created_at")

  planilla Planilla @relation(fields: [planillaId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, estadoNuevo, createdAt])
  @@map("planillas_historial")
}

// ═══════════════════════════════════════════════════════
// REGISTROS DE HORAS
// ═══════════════════════════════════════════════════════

model RegistroHoras {
  id                    String        @id @default(uuid())
  planillaId            String        @map("planilla_id")
  fecha                 DateTime
  entradaTurno1         DateTime?     @map("entrada_turno1")
  salidaTurno1          DateTime?     @map("salida_turno1")
  entradaTurno2         DateTime?     @map("entrada_turno2")
  salidaTurno2          DateTime?     @map("salida_turno2")
  cruzaMedianoche       Boolean       @default(false) @map("cruza_medianoche")
  lugarTrabajo          LugarTrabajo? @map("lugar_trabajo")
  pernocte              PernocteEnum  @default(NO)
  maneja                Boolean       @default(false)
  distanciaViaje        String?       @map("distancia_viaje")
  horasViajeInput       Decimal       @default(2) @map("horas_viaje_input") @db.Decimal(4, 2)
  esFeriado             Boolean       @default(false) @map("es_feriado")
  esFrancoCompensatorio Boolean       @default(false) @map("es_franco_compensatorio")
  esFrancoTrabajado     Boolean       @default(false) @map("es_franco_trabajado")
  horasTrabajadas       Decimal?      @map("horas_trabajadas") @db.Decimal(5, 2)
  horasNormales         Decimal       @default(0) @map("horas_normales") @db.Decimal(5, 2)
  horasExtra50          Decimal       @default(0) @map("horas_extra_50") @db.Decimal(5, 2)
  horasExtra100         Decimal       @default(0) @map("horas_extra_100") @db.Decimal(5, 2)
  horasViajeCalc        Decimal       @default(0) @map("horas_viaje_calc") @db.Decimal(5, 2)
  observaciones         String?
  bloqueado             Boolean       @default(false)
  motivoBloqueo         String?       @map("motivo_bloqueo")
  proyectoId            String?       @map("proyecto_id")
  marcaManualId         String?       @map("marca_manual_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  planilla Planilla  @relation(fields: [planillaId], references: [id], onDelete: Cascade)
  proyecto Proyecto? @relation(fields: [proyectoId], references: [id])
  marcaManual Ausencia? @relation("registro_marca_manual", fields: [marcaManualId], references: [id], onDelete: SetNull)

  @@unique([planillaId, fecha])
  @@map("registros_horas")
}

// ═══════════════════════════════════════════════════════
// VACACIONES
// ═══════════════════════════════════════════════════════

model Vacacion {
  id            String         @id @default(uuid())
  usuarioId     String         @map("usuario_id")
  flujoId       String?        @map("flujo_id")
  fechaInicio   DateTime       @map("fecha_inicio")
  fechaFin      DateTime       @map("fecha_fin")
  diasHabiles   Int            @map("dias_habiles")
  diasTotales   Int            @map("dias_totales")
  estado        VacacionEstado @default(BORRADOR)
  pasoActual    Int            @default(0) @map("paso_actual")
  motivo        String?
  obsRechazo    String?        @map("obs_rechazo")
  aprobadaPorId String?        @map("aprobada_por_id")
  aprobadaAt    DateTime?      @map("aprobada_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  usuario     Usuario             @relation(fields: [usuarioId], references: [id])
  aprobadaPor Usuario?            @relation("vacacion_aprobador", fields: [aprobadaPorId], references: [id])
  flujo       FlujoAprobacion?    @relation(fields: [flujoId], references: [id])
  historial   VacacionHistorial[]

  @@map("vacaciones")
}

model VacacionHistorial {
  id             String          @id @default(uuid())
  vacacionId     String          @map("vacacion_id")
  usuarioId      String          @map("usuario_id")
  estadoAnterior VacacionEstado? @map("estado_anterior")
  estadoNuevo    VacacionEstado  @map("estado_nuevo")
  pasoFlujo      Int?            @map("paso_flujo")
  comentario     String?
  createdAt      DateTime        @default(now()) @map("created_at")

  vacacion Vacacion @relation(fields: [vacacionId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, estadoNuevo, createdAt])
  @@map("vacaciones_historial")
}

model VacacionesConfig {
  id                      String   @id @default(uuid())
  empresaId               String   @unique @map("empresa_id")
  reglasAntiguedad        Json     @default("[]") @map("reglas_antiguedad")
  acumulacionActiva       Boolean  @default(true) @map("acumulacion_activa")
  acumulacionDiaDelMes    Int      @default(1) @map("acumulacion_dia_del_mes")
  acumulacionFrecuencia   String   @default("MENSUAL") @map("acumulacion_frecuencia")
  acumulacionMontoMensual Decimal? @map("acumulacion_monto_mensual") @db.Decimal(5, 2)
  vencimientoActivo       Boolean  @default(false) @map("vencimiento_activo")
  vencimientoMeses        Int      @default(12) @map("vencimiento_meses")
  bloquearEnPrueba        Boolean  @default(true) @map("bloquear_en_prueba")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("vacaciones_config")
}

// ── SALDO VACACIONES POR AÑO ─────────────────────
model VacacionSaldo {
  id                   String   @id @default(uuid())
  usuarioId            String   @map("usuario_id")
  anio                 Int      // e.g. 2026
  diasCorrespondientes Int      @map("dias_correspondientes") // calculated from seniority or override
  diasUsados           Int      @default(0) @map("dias_usados")
  diasPendientes       Int      @default(0) @map("dias_pendientes") // pending-approval requests
  diasAjuste           Int      @default(0) @map("dias_ajuste") // manual +/- adjustment by RRHH
  compensatoriosAcumulados  Int @default(0) @map("compensatorios_acumulados")  // earned by working on franco days
  compensatoriosUsados      Int @default(0) @map("compensatorios_usados")       // approved & not revoked
  compensatoriosPendientes  Int @default(0) @map("compensatorios_pendientes")   // pending approval
  override             Boolean  @default(false) // true if RRHH manually set diasCorrespondientes
  observaciones        String?  // notes on adjustments
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, anio])
  @@map("vacacion_saldos")
}

// ═══════════════════════════════════════════════════════
// AUSENCIAS
// ═══════════════════════════════════════════════════════

model Ausencia {
  id                  String         @id @default(uuid())
  usuarioId           String         @map("usuario_id")
  cargadaPorId        String?        @map("cargada_por_id")
  planillaId          String?        @map("planilla_id")
  flujoId             String?        @map("flujo_id")
  tipo                AusenciaTipo
  estado              AusenciaEstado @default(BORRADOR)
  pasoActual          Int            @default(0) @map("paso_actual")
  fechaInicio         DateTime       @map("fecha_inicio")
  fechaFin            DateTime       @map("fecha_fin")
  diasAusencia        Int            @map("dias_ausencia")
  descripcion         String?
  numeroCertificado   String?        @map("numero_certificado")
  archivoUrl          String?        @map("archivo_url")
  descuentaSueldo     Boolean        @default(false) @map("descuenta_sueldo")
  porcentajeDescuento Decimal        @default(0) @map("porcentaje_descuento") @db.Decimal(5, 2)
  obsRechazo          String?        @map("obs_rechazo")
  requiereAprobacion  Boolean        @default(false) @map("requiere_aprobacion")
  aprobada            Boolean        @default(true)
  aprobadaPorId       String?        @map("aprobada_por_id")
  aprobadaAt          DateTime?      @map("aprobada_at")
  cargaManual         Boolean        @default(false) @map("carga_manual")
  createdAt           DateTime       @default(now()) @map("created_at")

  usuario     Usuario              @relation(fields: [usuarioId], references: [id])
  cargadaPor  Usuario?             @relation("ausencia_cargador", fields: [cargadaPorId], references: [id])
  aprobadaPor Usuario?             @relation("ausencia_aprobador", fields: [aprobadaPorId], references: [id])
  flujo       FlujoAprobacion?     @relation(fields: [flujoId], references: [id])
  historial   AusenciaHistorial[]
  registrosMarcados   RegistroHoras[]      @relation("registro_marca_manual")

  @@map("ausencias")
}

model AusenciaHistorial {
  id             String          @id @default(uuid())
  ausenciaId     String          @map("ausencia_id")
  usuarioId      String          @map("usuario_id")
  estadoAnterior AusenciaEstado? @map("estado_anterior")
  estadoNuevo    AusenciaEstado  @map("estado_nuevo")
  pasoFlujo      Int?            @map("paso_flujo")
  comentario     String?
  createdAt      DateTime        @default(now()) @map("created_at")

  ausencia Ausencia @relation(fields: [ausenciaId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, estadoNuevo, createdAt])
  @@map("ausencias_historial")
}

// ═══════════════════════════════════════════════════════
// NOTIFICACIONES
// ═══════════════════════════════════════════════════════

model Notificacion {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  tipo      String
  titulo    String
  cuerpo    String?
  link      String?
  leida     Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("notificaciones")
}

// ═══════════════════════════════════════════════════════
// CONFIGURACIÓN DE EMPRESA
// ═══════════════════════════════════════════════════════

model EmpresaConfig {
  id                     String   @id @default(uuid())
  empresaId              String   @unique @map("empresa_id")
  periodoDiaInicio       Int      @default(21) @map("periodo_dia_inicio")
  periodoDiaFin          Int      @default(20) @map("periodo_dia_fin")
  maxHorasDiarias        Int      @default(16) @map("max_horas_diarias")
  horasJornadaNormal     Int      @default(8) @map("horas_jornada_normal")
  umbralExtra50          Int      @default(8) @map("umbral_extra_50")
  umbralExtra100         Int      @default(12) @map("umbral_extra_100")
  redondeoMinutos        Int      @default(15) @map("redondeo_minutos")
  descuentoAlmuerzoBase  Boolean  @default(true) @map("descuento_almuerzo_base")
  descuentoAlmuerzoCampo Boolean  @default(false) @map("descuento_almuerzo_campo")
  feriadosPersonalizados Json     @default("[]") @map("feriados_personalizados")
  moduloVacacionesActivo Boolean  @default(true) @map("modulo_vacaciones_activo")
  moduloAusenciasActivo  Boolean  @default(true) @map("modulo_ausencias_activo")
  moduloAnalyticsActivo  Boolean  @default(true) @map("modulo_analytics_activo")
  tarifaViajeManeja     Decimal  @default(0) @map("tarifa_viaje_maneja") @db.Decimal(8, 2)
  tarifaViajeSinManejar Decimal  @default(0) @map("tarifa_viaje_sin_manejar") @db.Decimal(8, 2)
  descuentoAlmuerzoMinutos Int   @default(60) @map("descuento_almuerzo_minutos")
  viandaUmbral1          Int      @default(6) @map("vianda_umbral_1")
  viandaUmbral2          Int      @default(10) @map("vianda_umbral_2")
  viandaCantidad1        Int      @default(1) @map("vianda_cantidad_1")
  viandaCantidad2        Int      @default(2) @map("vianda_cantidad_2")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("empresa_config")
}

// ═══════════════════════════════════════════════════════
// ADDENDUM — EXPORTACIONES
// ═══════════════════════════════════════════════════════

model Exportacion {
  id              String   @id @default(uuid())
  empresaId       String   @map("empresa_id")
  generadaPorId   String   @map("generada_por_id")
  periodoInicio   DateTime @map("periodo_inicio")
  periodoFin      DateTime @map("periodo_fin")
  sectoresIds     String[] @map("sectores_ids")
  usuariosIds     String[] @map("usuarios_ids")
  rolesFiltro     String[] @map("roles_filtro")
  hojasIncluidas  String[] @map("hojas_incluidas")
  incluyeSalarial Boolean  @default(false) @map("incluye_salarial")
  estadoPlanillas String[] @map("estado_planillas")
  nombreArchivo   String   @map("nombre_archivo")
  tamanioBytes    Int?     @map("tamanio_bytes")
  archivoUrl      String?  @map("archivo_url")
  totalPersonas   Int?     @map("total_personas")
  totalRegistros  Int?     @map("total_registros")
  creadoAt        DateTime @default(now()) @map("creado_at")

  empresa     Empresa @relation(fields: [empresaId], references: [id])
  generadaPor Usuario @relation(fields: [generadaPorId], references: [id])

  @@map("exportaciones")
}

model ExportacionPlantilla {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  creadaPorId   String   @map("creada_por_id")
  nombre        String
  descripcion   String?
  configuracion Json
  esPublica     Boolean  @default(false) @map("es_publica")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  creadaPor Usuario @relation(fields: [creadaPorId], references: [id])

  @@map("exportaciones_plantillas")
}

// ═══════════════════════════════════════════════════════
// ADDENDUM — PROYECTOS
// ═══════════════════════════════════════════════════════

model Proyecto {
  id          String    @id @default(uuid())
  empresaId   String    @map("empresa_id")
  codigo      String
  nombre      String
  cliente     String?
  descripcion String?
  fechaInicio DateTime? @map("fecha_inicio")
  fechaFin    DateTime? @map("fecha_fin")
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  empresa   Empresa         @relation(fields: [empresaId], references: [id])
  registros RegistroHoras[]

  @@map("proyectos")
}

// ═══════════════════════════════════════════════════════
// ADDENDUM — CAPACITACIONES
// ═══════════════════════════════════════════════════════

model TipoCapacitacion {
  id            String  @id @default(uuid())
  empresaId     String  @map("empresa_id")
  nombre        String
  descripcion   String?
  vigenciaDias  Int?    @map("vigencia_dias")
  esObligatoria Boolean @default(false) @map("es_obligatoria")
  alertaDias    Int     @default(30) @map("alerta_dias")
  activo        Boolean @default(true)

  empresa        Empresa                @relation(fields: [empresaId], references: [id])
  capacitaciones EmpleadoCapacitacion[]
  sesiones       SesionCapacitacion[]

  @@map("tipos_capacitacion")
}

model EmpleadoCapacitacion {
  id               String    @id @default(uuid())
  usuarioId        String    @map("usuario_id")
  tipoId           String    @map("tipo_id")
  fechaRealizacion DateTime  @map("fecha_realizacion")
  fechaVencimiento DateTime? @map("fecha_vencimiento")
  institucion      String?
  archivoUrl       String?   @map("archivo_url")
  observaciones    String?
  createdAt        DateTime  @default(now()) @map("created_at")

  usuario Usuario          @relation(fields: [usuarioId], references: [id])
  tipo    TipoCapacitacion @relation(fields: [tipoId], references: [id])

  @@map("empleado_capacitaciones")
}

// ═══════════════════════════════════════════════════════
// ADDENDUM — ALERTAS CONFIGURABLES
// ═══════════════════════════════════════════════════════

model AlertaConfig {
  id               String   @id @default(uuid())
  empresaId        String   @map("empresa_id")
  tipo             String
  activa           Boolean  @default(true)
  diasAnticipacion Int?     @map("dias_anticipacion")
  horasLimite      Int?     @map("horas_limite")
  rolesDestino     String[] @map("roles_destino")
  descripcion      String?
  createdAt        DateTime @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("alertas_config")
}

// ═══════════════════════════════════════════════════════
// MENSAJERÍA INTERNA
// ═══════════════════════════════════════════════════════

model Mensaje {
  id              String   @id @default(uuid())
  empresaId       String   @map("empresa_id")
  remitenteId     String   @map("remitente_id")
  asunto          String
  cuerpo          String
  archivoUrl      String?  @map("archivo_url")
  archivoNombre   String?  @map("archivo_nombre")
  permiteRespuesta Boolean @default(false) @map("permite_respuesta")
  esDifusion      Boolean  @default(false) @map("es_difusion")
  destinoTipo     String?  @map("destino_tipo")
  destinoValor    String?  @map("destino_valor")
  createdAt       DateTime @default(now()) @map("created_at")

  empresa       Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  remitente     Usuario                @relation("mensajesEnviados", fields: [remitenteId], references: [id], onDelete: Cascade)
  destinatarios MensajeDestinatario[]
  respuestas    MensajeRespuesta[]

  @@map("mensajes")
}

model MensajeDestinatario {
  id        String    @id @default(uuid())
  mensajeId String    @map("mensaje_id")
  usuarioId String    @map("usuario_id")
  leido     Boolean   @default(false)
  leidoAt   DateTime? @map("leido_at")
  createdAt DateTime  @default(now()) @map("created_at")

  mensaje Mensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  usuario Usuario @relation("mensajesRecibidos", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([mensajeId, usuarioId])
  @@map("mensaje_destinatarios")
}

model MensajeRespuesta {
  id            String   @id @default(uuid())
  mensajeId     String   @map("mensaje_id")
  usuarioId     String   @map("usuario_id")
  cuerpo        String
  archivoUrl    String?  @map("archivo_url")
  archivoNombre String?  @map("archivo_nombre")
  createdAt     DateTime @default(now()) @map("created_at")

  mensaje Mensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  usuario Usuario @relation("respuestasMensaje", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("mensaje_respuestas")
}

// ═══════════════════════════════════════════════════════
// SESIONES DE CAPACITACIÓN (Training Sessions)
// ═══════════════════════════════════════════════════════

model SesionCapacitacion {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  tipoId        String   @map("tipo_id")
  organizadorId String   @map("organizador_id")
  titulo        String
  descripcion   String?
  fecha         DateTime
  horaInicio    String?  @map("hora_inicio")
  horaFin       String?  @map("hora_fin")
  lugar         String?
  vacantes      Int
  estado        String   @default("ABIERTA") // ABIERTA, COMPLETA, EN_CURSO, FINALIZADA, CANCELADA
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  empresa      Empresa                    @relation(fields: [empresaId], references: [id])
  tipo         TipoCapacitacion           @relation(fields: [tipoId], references: [id])
  organizador  Usuario                    @relation("sesiones_organizadas", fields: [organizadorId], references: [id])
  invitaciones InvitacionCapacitacion[]

  @@map("sesiones_capacitacion")
}

model InvitacionCapacitacion {
  id            String    @id @default(uuid())
  sesionId      String    @map("sesion_id")
  usuarioId     String    @map("usuario_id")
  estado        String    @default("PENDIENTE") // PENDIENTE, ACEPTADA, RECHAZADA
  respondidoAt  DateTime? @map("respondido_at")
  motivoRechazo String?   @map("motivo_rechazo")
  asistio       Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")

  sesion  SesionCapacitacion @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  usuario Usuario            @relation("invitaciones_capacitacion", fields: [usuarioId], references: [id])

  @@unique([sesionId, usuarioId])
  @@map("invitaciones_capacitacion")
}

// ═══════════════════════════════════════════════════════
// SOLICITUDES DE CAMBIO DE DIAGRAMA
// ═══════════════════════════════════════════════════════

model SolicitudCambioDiagrama {
  id                String                @id @default(uuid())
  solicitanteId     String                @map("solicitante_id")
  usuarioId         String                @map("usuario_id")
  diagramaActualId  String?               @map("diagrama_actual_id")
  diagramaNuevoId   String                @map("diagrama_nuevo_id")
  flujoId           String?               @map("flujo_id")
  estado            CambioDiagramaEstado  @default(PENDIENTE)
  pasoActual        Int                   @default(1) @map("paso_actual")
  motivo            String?
  obsRechazo        String?               @map("obs_rechazo")
  aprobadaPorId     String?               @map("aprobada_por_id")
  aprobadaAt        DateTime?             @map("aprobada_at")
  fechaEfectiva     DateTime?             @map("fecha_efectiva")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  solicitante      Usuario          @relation("cambio_diagrama_solicitante", fields: [solicitanteId], references: [id])
  usuario          Usuario          @relation("cambio_diagrama_usuario", fields: [usuarioId], references: [id])
  diagramaActual   Diagrama?        @relation("cambio_diagrama_actual", fields: [diagramaActualId], references: [id])
  diagramaNuevo    Diagrama         @relation("cambio_diagrama_nuevo", fields: [diagramaNuevoId], references: [id])
  flujo            FlujoAprobacion? @relation(fields: [flujoId], references: [id])
  aprobadaPor      Usuario?         @relation("cambio_diagrama_aprobador", fields: [aprobadaPorId], references: [id])
  historial        CambioDiagramaHistorial[]

  @@map("solicitudes_cambio_diagrama")
}

model CambioDiagramaHistorial {
  id             String                @id @default(uuid())
  solicitudId    String                @map("solicitud_id")
  usuarioId      String                @map("usuario_id")
  estadoAnterior CambioDiagramaEstado? @map("estado_anterior")
  estadoNuevo    CambioDiagramaEstado  @map("estado_nuevo")
  pasoFlujo      Int?                  @map("paso_flujo")
  comentario     String?
  createdAt      DateTime              @default(now()) @map("created_at")

  solicitud SolicitudCambioDiagrama @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  usuario   Usuario                 @relation(fields: [usuarioId], references: [id])

  @@map("cambios_diagrama_historial")
}

// ─── Auditoría ────────────────────────────────────

model AuditoriaLog {
  id             String   @id @default(uuid())
  entidad        String   // e.g. "Usuario", "ConceptoValor", "ConceptoSalarial"
  entidadId      String   @map("entidad_id")
  accion         String   // "CREAR", "EDITAR", "ELIMINAR"
  campo          String?  // field name that changed (null for create/delete)
  valorAnterior  String?  @map("valor_anterior")
  valorNuevo     String?  @map("valor_nuevo")
  descripcion    String?  // human-readable summary
  usuarioId      String   @map("usuario_id")
  createdAt      DateTime @default(now()) @map("created_at")

  usuario Usuario @relation("auditoria_usuario", fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@map("auditoria_log")
}

// ═══════════════════════════════════════════════════════
// WENTOP — Tarjetas de Observación
// ═══════════════════════════════════════════════════════

enum WentopEstado {
  ABIERTA
  EN_PROGRESO
  CERRADA
}

enum WentopTipoTarjeta {
  DETENCION_TAREAS
  CONDICION_INSEGURA
  ACTO_INSEGURO
  CASI_ACCIDENTE
  OBSERVACION_POSITIVA
}

model WentopTarjeta {
  id                   String            @id @default(uuid())
  empresaId            String            @map("empresa_id")
  creadorId            String            @map("creador_id")
  sectorObservacionId  String?           @map("sector_observacion_id")
  sectorTercero        Boolean           @default(false) @map("sector_tercero")
  estado               WentopEstado      @default(ABIERTA)
  fechaReporte         DateTime          @map("fecha_reporte")
  cliente              String?
  lugarPozoLocacion    String?           @map("lugar_pozo_locacion")
  tipoTarjeta          WentopTipoTarjeta @map("tipo_tarjeta")
  calidad              Json?             @default("[]")
  medioambiente        Json?             @default("[]")
  seguridadSalud       Json?             @default("[]") @map("seguridad_salud")
  descripcion          String
  accionesInmediatas   String?           @map("acciones_inmediatas")
  recomendaciones      String?
  justificacionAbierta String?           @map("justificacion_abierta")
  accionCierre         String?           @map("accion_cierre")
  fechaCierre          DateTime?         @map("fecha_cierre")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  empresa           Empresa        @relation(fields: [empresaId], references: [id])
  creador           Usuario        @relation(fields: [creadorId], references: [id])
  sectorObservacion Sector?        @relation("wentop_sector_observacion", fields: [sectorObservacionId], references: [id])
  fotos             WentopFoto[]

  @@index([empresaId, estado])
  @@index([creadorId])
  @@index([sectorObservacionId])
  @@map("wentop_tarjetas")
}

model WentopFoto {
  id        String   @id @default(uuid())
  tarjetaId String   @map("tarjeta_id")
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  tarjeta WentopTarjeta @relation(fields: [tarjetaId], references: [id], onDelete: Cascade)

  @@map("wentop_fotos")
}

model WentopGestor {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  usuarioId String   @map("usuario_id")
  sectorId  String   @map("sector_id")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  sector  Sector  @relation(fields: [sectorId], references: [id])

  @@unique([usuarioId, sectorId])
  @@map("wentop_gestores")
}
